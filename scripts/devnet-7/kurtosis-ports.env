# Fixed host ports for rp-devnet-7 (must match network_params.yaml port_publisher).
# Single participant layout from ethereum-package:
#   EL start 32000: discovery=32000, engine=32001, metrics=32002, rpc=32003, ws=32004
#   CL start 33000: discovery=33000, http=33001, metrics=33002, quic=33003
#
# Sourced by generate-odao-config.sh and deploy.sh. Override any value before
# sourcing, or set EL_HTTP / EL_WS / CL_HTTP after.

KURTOSIS_HOST="${KURTOSIS_HOST:-127.0.0.1}"
KURTOSIS_EL_RPC_PORT="${KURTOSIS_EL_RPC_PORT:-32003}"
KURTOSIS_EL_WS_PORT="${KURTOSIS_EL_WS_PORT:-32004}"
KURTOSIS_CL_HTTP_PORT="${KURTOSIS_CL_HTTP_PORT:-33001}"

# Full URLs (used as Smart Node / Hardhat defaults)
KURTOSIS_EL_HTTP_DEFAULT="${KURTOSIS_EL_HTTP_DEFAULT:-http://${KURTOSIS_HOST}:${KURTOSIS_EL_RPC_PORT}}"
KURTOSIS_EL_WS_DEFAULT="${KURTOSIS_EL_WS_DEFAULT:-ws://${KURTOSIS_HOST}:${KURTOSIS_EL_WS_PORT}}"
KURTOSIS_CL_HTTP_DEFAULT="${KURTOSIS_CL_HTTP_DEFAULT:-http://${KURTOSIS_HOST}:${KURTOSIS_CL_HTTP_PORT}}"
